    "agentation": "^1.3.2",
    "commitlint": "^20.3.1",
    "dd-trace": "^5.84.0",
    "embla-carousel-react": "^8.6.0",
    "matter-js": "^0.20.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "storybook": "^10.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.2.0",
